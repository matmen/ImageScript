{
  "name": "imagescript",
  "version": "3.11.0",
  "description": "zero-dependency javascript image manipulation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.MIT",
    "LICENSE.AGPL-3.0",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "docs": "node scripts/docs.js",
    "test": "npm run build && node ./tests/run.js",
    "coverage": "node scripts/build.js --source-maps && c8 node ./tests/run.js && node scripts/coverage-report.js",
    "prepack": "npm run build",
    "version": "node scripts/version.js && git add src/version.ts jsr.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matmen/ImageScript.git"
  },
  "keywords": [
    "image",
    "image processing",
    "image manipulation",
    "png",
    "jpeg",
    "jpg",
    "scale",
    "resize",
    "crop",
    "svg",
    "bitmap",
    "gif",
    "picture",
    "thumbnail",
    "webp",
    "avif",
    "av1",
    "jxl",
    "jpeg xl",
    "apng",
    "tiff",
    "tga",
    "bmp",
    "ico",
    "cur",
    "qoi",
    "netpbm",
    "ppm",
    "pgm",
    "pbm",
    "pam",
    "pfm",
    "hdr",
    "radiance",
    "animation",
    "text rendering",
    "font"
  ],
  "author": "Mathis Mensing <mathis@matmen.dev>",
  "license": "(AGPL-3.0-or-later OR MIT)",
  "bugs": {
    "url": "https://github.com/matmen/ImageScript/issues"
  },
  "homepage": "https://github.com/matmen/ImageScript#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-sonarjs": "4.2.2",
    "typedoc": "0.27.9",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.0"
  }
}
