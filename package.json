{
  "name": "imagescript",
  "version": "3.0.0",
  "description": "zero-dependency javascript image manipulation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.MIT",
    "LICENSE.AGPL-3.0",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "node scripts/docs.js",
    "test": "npm run build && node ./tests/run.js",
    "prepack": "npm run build",
    "version": "node scripts/build.js && git add src/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matmen/ImageScript.git"
  },
  "keywords": [
    "image",
    "image processing",
    "image manipulation",
    "png",
    "jpeg",
    "jpg",
    "scale",
    "resize",
    "crop",
    "svg",
    "bitmap",
    "gif",
    "picture",
    "thumbnail"
  ],
  "author": "Mathis Mensing <mathis@matmen.dev>",
  "license": "(AGPL-3.0-or-later OR MIT)",
  "bugs": {
    "url": "https://github.com/matmen/ImageScript/issues"
  },
  "homepage": "https://github.com/matmen/ImageScript#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "typedoc": "0.27.9",
    "typescript": "5.7.3"
  }
}
